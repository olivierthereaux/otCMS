mkdir -p tn
for i in *
do
  if echo "$i" | grep -v tn_ | grep -v "\.html" | grep -v "\.sh" | grep -v "\.rdf" | grep -v "\.md" | grep -v "\.php" | grep -q "\."
  then
    base="${i%.*}"
    echo -n "-> tn/lg_$base.jpg "
    convert "$i" -thumbnail 500x500^ -gravity center -extent 500x500 "tn/lg_$base.jpg" 2>&1 > /dev/null
    echo -n "$i -> tn/tn_$base.jpg : "
    convert "$i" -thumbnail 250x250^ -gravity center -extent 250x250 "tn/tn_$base.jpg" 2>&1 > /dev/null

    if [ ! -r "tn/tn_$base.jpg" ]
    then
        echo failed creating.
    else
        echo done.
    fi
  fi
done
